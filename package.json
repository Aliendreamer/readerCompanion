{
  "name": "reader-companion-devtools",
  "private": true,
  "description": "Dev-only tooling for readerCompanion: git hooks, formatting and Markdown linting.",
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "prepare": "husky",
    "format": "dotnet format ReaderCompanion.slnx",
    "format:check": "dotnet format ReaderCompanion.slnx --verify-no-changes",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "markdownlint-cli2": "0.24.1"
  }
}
