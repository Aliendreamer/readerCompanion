<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- WinExe: no console window on Windows; behaves like Exe on Linux. -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit pin lifts Photino.Blazor's transitive WebView 9.0.1 to the .NET 10 version. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" />
    <PackageReference Include="Photino.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReaderCompanion.Data\ReaderCompanion.Data.csproj" />
    <ProjectReference Include="..\ReaderCompanion.UI\ReaderCompanion.UI.csproj" />
  </ItemGroup>

  <!-- The app's Google OAuth client (Google's "Desktop app" download), stored encrypted with git-crypt. Builds run by
       Claude Code (CLAUDECODE=1) skip it: the agent's sandbox is not allowed to read it. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\google-oauth-client.json') And '$(CLAUDECODE)' != '1'">
    <None Include="$(MSBuildThisFileDirectory)..\..\google-oauth-client.json" Link="google-oauth-client.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
