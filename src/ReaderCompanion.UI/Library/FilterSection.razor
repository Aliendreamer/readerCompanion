@typeparam TValue where TValue : notnull
@inject FilterTreeState Tree

@* One section of the filter tree: a header that opens and closes it, and its values as ticks. The picked values stay
   ticked in the list; long lists get a find box and are shown a page at a time. *@

@if (Options.Count > 0)
{
  <div class="filter-section">
    <button id="@Id" type="button" class="filter-section-header" aria-expanded="@(IsOpen ? "true" : "false")"
            @onclick="() => Tree.Toggle(Id)">
      <svg class="filter-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
      <span class="filter-section-name">@Label</span>
      <span class="filter-section-size">(@Options.Count)</span>
      @if (Picked.Count > 0)
      {
        <span class="filter-count" aria-label="@($"{Picked.Count} picked")">@Picked.Count</span>
      }
    </button>

    @if (IsOpen)
    {
      <div id="@($"{Id}-menu")" class="filter-section-body" role="group" aria-label="@Label">
        @if (Options.Count >= SearchFrom)
        {
          <input class="filter-search" type="search" placeholder="Find…" aria-label="Find @Label.ToLowerInvariant()"
                 @bind="_find" @bind:event="oninput" />
        }
        <ul class="filter-options">
          @foreach (var option in _pager.Page(Shown))
          {
            <li>
              <label class="filter-option">
                <input type="checkbox" checked="@Picked.Contains(option)" @onchange="e => SetAsync(option, e.Value is true)" />
                @Text(option)
              </label>
              @if (Note(option) is { } note)
              {
                <span class="filter-note">@note</span>
              }
            </li>
          }
        </ul>
        <MoreMarker Shown="_pager.Shown(Shown.Count)" Total="Shown.Count" OnMore="_pager.More" />
        @if (Picked.Count > 0)
        {
          <button type="button" class="filter-clear link-button" @onclick="ClearAsync">Clear</button>
        }
      </div>
    }
  </div>
}

@code {
  /// <summary>From this many options on, the section gets a find box.</summary>
  private const int SearchFrom = 8;

  [Parameter, EditorRequired] public string Id { get; set; } = "";

  [Parameter, EditorRequired] public string Label { get; set; } = "";

  [Parameter, EditorRequired] public IReadOnlyList<TValue> Options { get; set; } = [];

  /// <summary>How a value reads on screen.</summary>
  [Parameter] public Func<TValue, string> Text { get; set; } = v => v.ToString() ?? "";

  /// <summary>A short note shown after a value, such as how many books have it; none when null.</summary>
  [Parameter] public Func<TValue, string?> Note { get; set; } = _ => null;

  [Parameter] public IReadOnlyCollection<TValue> Picked { get; set; } = [];

  [Parameter] public EventCallback<IReadOnlyCollection<TValue>> PickedChanged { get; set; }

  private string _find = "";
  private readonly Pager _pager = new();
  private IReadOnlyList<TValue> _shown = [];
  private (IReadOnlyList<TValue> Options, string Find)? _shownFor;

  private bool IsOpen => Tree.IsOpen(Id);

  // The same list object while the options and the search stay the same, so ticking keeps the page; a new search
  // gives a new list, which starts again from the first page.
  private IReadOnlyList<TValue> Shown
  {
    get
    {
      if (_shownFor is not { } key || !ReferenceEquals(key.Options, Options) || key.Find != _find)
      {
        _shown = _find.Length == 0 ? Options : [.. Options.Where(o => Text(o).Contains(_find, StringComparison.CurrentCultureIgnoreCase))];
        _shownFor = (Options, _find);
      }

      return _shown;
    }
  }

  private Task SetAsync(TValue value, bool on) => PickedChanged.InvokeAsync(on
    ? [.. Picked.Where(v => !v.Equals(value)), value]
    : [.. Picked.Where(v => !v.Equals(value))]);

  private Task ClearAsync() => PickedChanged.InvokeAsync([]);
}
