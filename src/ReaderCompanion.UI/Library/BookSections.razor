@using ReaderCompanion.Core.Library
@using ReaderCompanion.Core.Preferences

@* Ungrouped books render as a plain grid or table; grouped ones get a collapsible section each. Only the first
   Limit books are built; a marker after them asks for more when it comes near the view. *@

@foreach (var (part, books) in _visible)
{
  if (part.Name is null)
  {
    <BookView Books="books" View="View" OnSelect="OnSelect" />
  }
  else
  {
    <details class="book-section" open @key="(part.Name, part.IsCatchAll)">
      <summary>
        <span class="section-name">@part.Name</span> <span class="section-count">(@part.Books.Count)</span>
      </summary>
      <BookView Books="books" View="View" OnSelect="OnSelect" />
    </details>
  }
}

<MoreMarker Id="show-more" Shown="_shown" Total="_total" OnMore="() => ShowMore.InvokeAsync()" />

@code {
  [Parameter, EditorRequired] public IReadOnlyList<BookSection> Sections { get; set; } = [];

  [Parameter] public LibraryView View { get; set; }

  [Parameter] public EventCallback<BookListItem> OnSelect { get; set; }

  /// <summary>How many books to build, across all sections.</summary>
  [Parameter] public int Limit { get; set; } = int.MaxValue;

  /// <summary>Asked when more books should be built (the marker came near the view, or Show more).</summary>
  [Parameter] public EventCallback ShowMore { get; set; }

  private List<(BookSection Part, IReadOnlyList<BookListItem> Books)> _visible = [];
  private int _shown;
  private int _total;
  protected override void OnParametersSet()
  {
    _visible = [];
    var left = Limit;
    foreach (var part in Sections)
    {
      if (left <= 0)
      {
        break;
      }

      IReadOnlyList<BookListItem> books = part.Books.Count <= left ? part.Books : [.. part.Books.Take(left)];
      _visible.Add((part, books));
      left -= books.Count;
    }

    _shown = _visible.Sum(v => v.Books.Count);
    _total = Sections.Sum(s => s.Books.Count);
  }
}
