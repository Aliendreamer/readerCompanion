@using ReaderCompanion.Core.Library

<table class="book-table">
  <thead>
    <tr>
      <th class="col-cover"><span class="visually-hidden">Cover</span></th>
      <th>Title</th>
      <th>Author</th>
      <th>Series</th>
      <th class="col-status"><span class="visually-hidden">Status</span></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var book in Books)
    {
      <tr class="@(book.Id == SelectedId ? "selected" : null)" @key="book.Id" @onclick="() => OnSelect.InvokeAsync(book)">
        <td class="col-cover"><div class="table-cover"><BookCover Book="book" /></div></td>
        <td><button type="button" class="book-title" @onclick="() => OnSelect.InvokeAsync(book)">@book.Title</button></td>
        <td><span class="book-authors">@BookText.Authors(book)</span></td>
        <td>
          @if (BookText.Series(book) is { } series)
          {
            <span class="book-series">@series</span>
          }
        </td>
        <td class="col-status">
          <StatusBadge Status="book.ReadStatus" />
          @if (book.FileMissing)
          {
            <span class="book-missing">missing file</span>
          }
        </td>
      </tr>
    }
  </tbody>
</table>

@code {
  [Parameter, EditorRequired] public IReadOnlyList<BookListItem> Books { get; set; } = [];

  /// <summary>Raised when the user picks a book to see its details.</summary>
  [Parameter] public EventCallback<BookListItem> OnSelect { get; set; }

  [Parameter] public int? SelectedId { get; set; }
}
