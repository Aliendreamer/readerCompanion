@using ReaderCompanion.Core.Library
@using ReaderCompanion.Core.Preferences

@if (View == LibraryView.Table)
{
  <BookTable Books="Books" OnSelect="OnSelect" SelectedId="SelectedId" />
}
else
{
  <BookGrid Books="Books" OnSelect="OnSelect" SelectedId="SelectedId" />
}

@code {
  [Parameter, EditorRequired] public IReadOnlyList<BookListItem> Books { get; set; } = [];

  [Parameter] public LibraryView View { get; set; }

  [Parameter] public EventCallback<BookListItem> OnSelect { get; set; }

  /// <summary>The book whose details are shown, marked in the list.</summary>
  [Parameter] public int? SelectedId { get; set; }
}
