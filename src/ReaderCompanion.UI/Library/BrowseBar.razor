@using ReaderCompanion.Core.Library
@using ReaderCompanion.Core.Preferences

<div class="browse-bar">
  <div class="browse-row">
    <button id="filters-toggle" type="button" class="btn filters-toggle" @onclick="() => ToggleFilters.InvokeAsync()">Filters</button>
    <input id="browse-search" class="browse-search" type="search" placeholder="Search title or author…"
           aria-label="Search title or author" value="@Query.Search"
           @oninput="e => Change(Query with { Search = e.Value as string ?? string.Empty })" />
    <label class="browse-select">
      <span>Group</span>
      <select id="browse-group" value="@Query.Group" @onchange="e => Change(Query with { Group = Parse<LibraryGroup>(e) })">
        <option value="@LibraryGroup.None">None</option>
        <option value="@LibraryGroup.Author">Author</option>
        <option value="@LibraryGroup.Collection">Collection</option>
        <option value="@LibraryGroup.Genre">Genre</option>
      </select>
    </label>
    <label class="browse-select" title="@(SortFixed ? "Collections always list in series order" : null)">
      <span>Sort</span>
      <select id="browse-sort" value="@Query.Sort" disabled="@SortFixed"
              @onchange="e => Change(Query with { Sort = Parse<LibrarySort>(e) })">
        <option value="@LibrarySort.Title">Title</option>
        <option value="@LibrarySort.Author">Author</option>
        <option value="@LibrarySort.Series">Series order</option>
        <option value="@LibrarySort.DateAdded">Date added</option>
      </select>
    </label>
    <ViewToggle Value="View" ValueChanged="ViewChanged" />
  </div>
</div>

@code {
  [Parameter, EditorRequired] public BrowseQuery Query { get; set; } = new();

  [Parameter] public EventCallback<BrowseQuery> QueryChanged { get; set; }

  [Parameter] public LibraryView View { get; set; }

  [Parameter] public EventCallback<LibraryView> ViewChanged { get; set; }

  // Grouped by collection, books always read in series order, so the sort has no effect.
  private bool SortFixed => Query.Group == LibraryGroup.Collection;

  /// <summary>Shows or hides the filter tree on a narrow window (the button is shown only there).</summary>
  [Parameter] public EventCallback ToggleFilters { get; set; }

  private Task Change(BrowseQuery query) => QueryChanged.InvokeAsync(query);

  private static T Parse<T>(ChangeEventArgs e) where T : struct, Enum => Enum.Parse<T>((string)e.Value!);
}
