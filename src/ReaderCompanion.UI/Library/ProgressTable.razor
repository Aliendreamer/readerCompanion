@using ReaderCompanion.Core.Library
@using ReaderCompanion.UI.Library

<table class="progress-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Read</th>
      <th class="visually-hidden">Progress</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var row in _pager.Page(Rows))
    {
      <tr>
        <td>@row.Name</td>
        <td>@row.Read of @row.Total read</td>
        <td><progress max="@row.Total" value="@row.Read">@row.Read of @row.Total</progress></td>
      </tr>
    }
  </tbody>
</table>
<MoreMarker Shown="_pager.Shown(Rows.Count)" Total="Rows.Count" OnMore="_pager.More" />

@code {
  [Parameter, EditorRequired] public IReadOnlyList<Progress> Rows { get; set; } = [];

  private readonly Pager _pager = new();
}
