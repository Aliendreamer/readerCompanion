@page "/settings"
@using ReaderCompanion.Core.Library
@using ReaderCompanion.Core.Preferences
@using ReaderCompanion.Core.Scanning
@using ReaderCompanion.UI.Library
@inject ILibraryLocation Location
@inject IAppPreferences Preferences
@inject ILibraryFolders Folders
@inject IFileLauncher Launcher
@inject ICoverFetcher Covers
@implements IDisposable

<h1 class="visually-hidden">Settings</h1>
<p class="page-intro">Where your library lives and what it is linked to. Each part is changed on its own page.</p>

<div class="settings">
<section class="card settings-data">
  <h2>Data folder</h2>
  <p>Your library (books, details, collections, reading) and the covers are kept in:</p>
  <p class="folder-path">@Location.DataFolder</p>
  <button id="settings-show-data" type="button" class="btn btn-small" @onclick="ShowDataFolder">Show in folder</button>
  @if (_error is not null)
  {
    <p class="panel-error" role="alert">@_error</p>
  }
  <p class="muted">To keep a copy, use <a href="backup">Backup</a>.</p>
</section>

<section class="card settings-backup">
  <h2>Backups</h2>
  @if (Preferences.Current.BackupFolder is { } folder)
  {
    <p>Backups go to <span class="folder-path">@folder</span>@(Directory.Exists(folder) ? "" : " (folder not found)")@(Preferences.Current.BackupOnExit
      ? $", and one is made on close (keeping the last {Preferences.Current.KeepBackups})." : ".")</p>
  }
  else
  {
    <p>No backup folder chosen yet.</p>
  }
  <a href="backup">Change backups</a>
</section>

<section class="card settings-covers">
  <h2>Covers</h2>
  <label class="browse-check">
    <input id="covers-online" type="checkbox" checked="@Preferences.Current.OnlineCovers"
           @onchange="SetOnlineCovers" />
    Get missing covers from Open Library (contacts openlibrary.org, only when you press Fetch)
  </label>
  @if (Preferences.Current.OnlineCovers || _fetching is not null)
  {
    <div class="backup-actions">
      @if (_fetching is null)
      {
        <button id="covers-fetch" type="button" class="btn btn-small" @onclick="FetchCoversAsync">Fetch missing covers</button>
      }
      else
      {
        <button id="covers-stop" type="button" class="btn btn-small" @onclick="() => _fetching?.Cancel()">Stop</button>
      }
      @if (_coverStatus is not null)
      {
        <span class="muted">@_coverStatus</span>
      }
    </div>
  }
</section>

<section class="card settings-sources">
  <h2>Linked sources</h2>
  <p>@(_folders is { } count ? $"{BookText.Plural(count, "local folder")} linked. " : "")Last Goodreads import: @(Preferences.Current.GoodreadsLastImportUtc is { } last ? BookText.Date(last) : "never").</p>
  <a href="sources">Change sources</a>
</section>
</div>

@code {
  private int? _folders; // unknown until loaded (or if loading fails)
  private CancellationTokenSource? _fetching;
  private string? _coverStatus;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      _folders = (await Folders.ListAsync()).Count;
    }
    catch (Exception e) when (e is not OperationCanceledException)
    {
      _error = $"The linked folders could not be read: {e.Message}";
    }
  }

  // One request per second; progress shows as it goes, and Stop cancels between books.
  private async Task FetchCoversAsync()
  {
    using var fetching = _fetching = new CancellationTokenSource();
    // Progress callbacks arrive later on the dispatcher; once the fetch is over, they must not overwrite the result.
    var progress = new Progress<(int Done, int Total)>(p =>
    {
      if (_fetching == fetching)
      {
        _coverStatus = $"Looking up {p.Done} of {p.Total}…";
        InvokeAsync(StateHasChanged);
      }
    });
    try
    {
      var result = await Covers.FetchMissingAsync(progress, fetching.Token);
      _coverStatus = result.Looked == 0 ? "Every book with an ISBN already has a cover."
        : $"{BookText.Plural(result.Found, "cover")} found of {result.Looked}" +
          (result.Failed > 0 ? $"; {result.Failed} could not be looked up." : ".");
    }
    catch (OperationCanceledException)
    {
      _coverStatus = "Stopped. Covers found so far are kept.";
    }
    finally
    {
      _fetching = null;
    }
  }

  // Turning the switch off also stops a fetch that is running: off means no more requests.
  private void SetOnlineCovers(ChangeEventArgs e)
  {
    var on = e.Value is true;
    Preferences.Save(Preferences.Current with { OnlineCovers = on });
    if (!on)
    {
      _fetching?.Cancel();
    }
  }

  // Leaving the page stops the fetch: it never runs without the page showing it.
  public void Dispose() => _fetching?.Cancel();

  // The launcher shows the folder that holds a file: the database sits in the data folder.
  private void ShowDataFolder() =>
    _error = Launcher.ShowInFolder(Location.DatabasePath) ? null : "The data folder could not be shown.";
}
