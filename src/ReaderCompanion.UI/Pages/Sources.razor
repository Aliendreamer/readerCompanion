@using ReaderCompanion.UI.Library
@page "/sources"
@inject ILibraryFolders Folders
@inject ILibraryScanner Scanner
@inject IFolderPicker Picker
@inject ScanStatus Status
@implements IDisposable

<h1 class="visually-hidden">Sources</h1>
<p class="page-intro">Link the places your books come from.</p>

<section class="source card">
  <h2>Local folders</h2>

  @if (_folders.Count == 0)
  {
    <p class="muted">No folders linked yet.</p>
  }
  else
  {
    <ul class="folder-list">
      @foreach (var folder in _folders)
      {
        <li>
          <span class="folder-path">@folder</span>
          <button class="unlink btn btn-small" disabled="@Scanning" @onclick="() => UnlinkAsync(folder)">Unlink</button>
        </li>
      }
    </ul>
  }

  <div class="source-actions">
    <button id="link-folder" class="btn" disabled="@Scanning" @onclick="LinkAsync">Link folder…</button>
    <button id="scan" class="btn btn-primary" disabled="@(Scanning || _folders.Count == 0)" @onclick="ScanAsync">Scan</button>
  </div>

  @if (Message is not null)
  {
    <p class="message">@Message</p>
  }

  @if (Scan.IsRunning)
  {
    var progress = Scan.Progress ?? new ScanProgress(0, 0);
    <p class="progress">Scanning… @progress.FilesProcessed of @progress.FilesFound files</p>
  }

  @if (Scan.Summary is { } summary)
  {
    <ScanSummaryView Summary="summary" />
  }
</section>

<GoogleDriveSource />

<GoodreadsSource />

@code {
  private IReadOnlyList<string> _folders = [];
  private string? _message;

  // The scan lives in ScanStatus, so leaving the page and coming back shows it where it is.
  private TrackedScan Scan => Status.Library;

  private bool Scanning => Scan.IsRunning || Scanner.IsScanning;

  private string? Message => _message ?? (Scan.Failure is { } failure ? $"The scan failed: {failure.Message}" : null);

  protected override async Task OnInitializedAsync()
  {
    Scan.Changed += OnScanChanged;
    _folders = await Folders.ListAsync();
  }

  private void OnScanChanged() => InvokeAsync(StateHasChanged);

  public void Dispose() => Scan.Changed -= OnScanChanged;

  private async Task LinkAsync()
  {
    var path = await Picker.PickFolderAsync();
    if (path is null)
    {
      return;
    }

    var result = await Folders.LinkAsync(path);
    _folders = await Folders.ListAsync();
    if (!result.Linked)
    {
      _message = result.RefusedReason;
      return;
    }

    // A new folder is scanned at once, so its books show up without a second step.
    await ScanAsync(result.Replaced.Count > 0 ? $"Linked. It now also covers {string.Join(", ", result.Replaced)}." : null);
  }

  private async Task UnlinkAsync(string folder)
  {
    await Folders.UnlinkAsync(folder);
    _message = $"Unlinked {folder}. Its books stay in the library, with their files marked missing.";
    _folders = await Folders.ListAsync();
  }

  private Task ScanAsync() => ScanAsync(null);

  private Task ScanAsync(string? message)
  {
    _message = message;
    return Scan.RunAsync(progress => Scanner.ScanAsync(progress));
  }
}
