@using ReaderCompanion.UI.Library
@page "/sources"
@inject ILibraryFolders Folders
@inject ILibraryScanner Scanner
@inject IFolderPicker Picker

<h1 class="visually-hidden">Sources</h1>
<p class="page-intro">Link the places your books come from.</p>

<section class="source card">
  <h2>Local folders</h2>

  @if (_folders.Count == 0)
  {
    <p class="muted">No folders linked yet.</p>
  }
  else
  {
    <ul class="folder-list">
      @foreach (var folder in _folders)
      {
        <li>
          <span class="folder-path">@folder</span>
          <button class="unlink btn btn-small" disabled="@_scanning" @onclick="() => UnlinkAsync(folder)">Unlink</button>
        </li>
      }
    </ul>
  }

  <div class="source-actions">
    <button id="link-folder" class="btn" disabled="@_scanning" @onclick="LinkAsync">Link folder…</button>
    <button id="scan" class="btn btn-primary" disabled="@(_scanning || _folders.Count == 0)" @onclick="ScanAsync">Scan</button>
  </div>

  @if (_message is not null)
  {
    <p class="message">@_message</p>
  }

  @if (_progress is not null)
  {
    <p class="progress">Scanning… @_progress.FilesProcessed of @_progress.FilesFound files</p>
  }

  @if (_summary is not null)
  {
    <ScanSummaryView Summary="_summary" />
  }
</section>

<GoogleDriveSource />

<GoodreadsSource />

@code {
  private IReadOnlyList<string> _folders = [];
  private string? _message;
  private bool _scanning;
  private ScanProgress? _progress;
  private ScanSummary? _summary;

  protected override async Task OnInitializedAsync()
  {
    _scanning = Scanner.IsScanning;
    _folders = await Folders.ListAsync();
  }

  private async Task LinkAsync()
  {
    var path = await Picker.PickFolderAsync();
    if (path is null)
    {
      return;
    }

    var result = await Folders.LinkAsync(path);
    _folders = await Folders.ListAsync();
    if (!result.Linked)
    {
      _message = result.RefusedReason;
      return;
    }

    // A new folder is scanned at once, so its books show up without a second step.
    await ScanAsync(result.Replaced.Count > 0 ? $"Linked. It now also covers {string.Join(", ", result.Replaced)}." : null);
  }

  private async Task UnlinkAsync(string folder)
  {
    await Folders.UnlinkAsync(folder);
    _message = $"Unlinked {folder}. Its books stay in the library, with their files marked missing.";
    _folders = await Folders.ListAsync();
  }

  private Task ScanAsync() => ScanAsync(null);

  private async Task ScanAsync(string? message)
  {
    _scanning = true;
    _message = message;
    _summary = null;
    _progress = new ScanProgress(0, 0);
    try
    {
      _summary = await Scanner.ScanAsync(new UiProgress(this));
    }
    catch (Exception ex)
    {
      _message = $"The scan failed: {ex.Message}";
    }
    finally
    {
      _scanning = false;
      _progress = null;
    }
  }

  private sealed class UiProgress(Sources page) : IProgress<ScanProgress>
  {
    public void Report(ScanProgress value) => _ = page.InvokeAsync(() =>
    {
      page._progress = value;
      page.StateHasChanged();
    });
  }
}
