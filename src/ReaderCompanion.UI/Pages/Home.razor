@page "/"
@using ReaderCompanion.Core.Library
@using ReaderCompanion.Core.Preferences
@using ReaderCompanion.Core.Goodreads
@using ReaderCompanion.UI.Library
@inject ILibraryBooks Books
@inject IAppPreferences Preferences

<h1 class="visually-hidden">Library</h1>

@if (!_reminderDismissed && GoodreadsReminder.IsDue(Preferences.Current.GoodreadsLastImportUtc, Preferences.Current.GoodreadsReminderMonths, DateTime.UtcNow))
{
  <div class="goodreads-reminder card" role="status">
    <span>
      Your Goodreads import is more than @BookText.Plural(Preferences.Current.GoodreadsReminderMonths, "month") old. On goodreads.com
      open My Books → Import and export → Export library, then import the new file on <a href="sources">Sources</a>.
    </span>
    <button type="button" class="link-button" @onclick="() => _reminderDismissed = true">Dismiss</button>
  </div>
}

@if (_books is null)
{
  <p class="muted">Loading…</p>
}
else if (_books.Count == 0)
{
  <div class="empty-state card">
    <p class="empty-title">Your library is empty.</p>
    <p>Link a folder of e-books on the <a href="sources">Sources</a> page and scan it.</p>
  </div>
}
else
{
  <div class="library @(_selected is null ? null : "has-panel")">
    <BrowseBar Query="Query" QueryChanged="ChangeQuery" Options="_options" View="View" ViewChanged="ChangeView" />
    <div class="browse-summary">
      <p class="book-count">@Count()</p>
      @if (Query.IsNarrowed)
      {
        <button id="clear-filters" type="button" class="link-button" @onclick="ClearFilters">Clear filters</button>
      }
    </div>

    @if (_result.Shown == 0)
    {
      <div class="empty-state card">
        <p class="empty-title">No books match.</p>
        <p>Try a different search, or clear the filters.</p>
      </div>
    }
    else
    {
      @* Keyed on the grouping so a new grouping starts with every section open. *@
      <BookSections @key="Query.Group" Sections="_result.Sections" View="View" OnSelect="b => _selected = b.Id"
                    Limit="_limit" ShowMore="() => _limit += PageSize" />
    }
  </div>

  @if (_selected is { } id)
  {
    <BookPanel @key="id" BookId="id" OnClose="() => _selected = null" OnSaved="ReloadAsync" AllCollections="_userCollections" />
  }
}

@code {
  private IReadOnlyList<BookListItem>? _books;
  private BrowseOptions _options = BrowseOptions.Empty;
  private IReadOnlyList<string> _userCollections = [];

  // Search and filters live only on this page; grouping and sort are always read from the preferences.
  private BrowseQuery _filters = new();
  private BrowseResult _result = new(0, 0, []);
  private int? _selected;
  private bool _reminderDismissed; // until the app restarts

  // A large library is built a page at a time, more as the list nears the view; a new search starts again.
  private const int PageSize = 120;
  private int _limit = PageSize;

  private LibraryView View => Preferences.Current.LibraryView;

  private BrowseQuery Query => _filters with
  {
    Group = Preferences.Current.LibraryGroup,
    Sort = Preferences.Current.LibrarySort,
  };

  protected override Task OnInitializedAsync() => ReloadAsync();

  // Reloads the books (after an edit, too) and re-applies the current search, filters, grouping and sort.
  private async Task ReloadAsync()
  {
    _books = await Books.ListAsync();
    _options = LibraryBrowser.Options(_books);
    _userCollections = LibraryBrowser.UserCollections(_books);
    Refresh();
  }

  private void Refresh() => _result = LibraryBrowser.Browse(_books ?? [], Query);

  private string Count() =>
    Query.IsNarrowed ? $"{_result.Shown} of {_result.Total} books"
      : _result.Total == 1 ? "1 book"
      : $"{_result.Total} books";

  private void ChangeQuery(BrowseQuery query)
  {
    _filters = query;
    var current = Preferences.Current;
    if (query.Group != current.LibraryGroup || query.Sort != current.LibrarySort)
    {
      Preferences.Save(current with { LibraryGroup = query.Group, LibrarySort = query.Sort });
    }

    _limit = PageSize;
    Refresh();
  }

  private void ClearFilters()
  {
    _filters = new();
    _limit = PageSize;
    Refresh();
  }

  private void ChangeView(LibraryView view) => Preferences.Save(Preferences.Current with { LibraryView = view });
}
