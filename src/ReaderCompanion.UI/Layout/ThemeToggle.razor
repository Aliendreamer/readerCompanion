@using ReaderCompanion.Core.Preferences
@inject IAppPreferences Preferences
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ISystemTheme SystemTheme

@* The light/dark switch in the toolbar; "Use system theme" is on the Settings page. *@
<button id="theme-toggle" type="button" role="switch" class="toolbar-switch" aria-checked="@(IsDark ? "true" : "false")"
        title="Dark theme" @onclick="Flip">
  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 1.5A6.5 6.5 0 1 0 14.5 11 5.5 5.5 0 0 1 10.5 1.5z" /></svg>
  <span class="toolbar-label">Dark</span>
</button>

@code {
  private bool _systemDark;
  private IAsyncDisposable? _subscription;

  private bool IsDark => Preferences.Current.Theme switch
  {
    ThemeChoice.Dark => true,
    ThemeChoice.Light => false,
    _ => _systemDark,
  };

  // The theme can also change elsewhere ("Use system theme" in Settings): show it.
  protected override void OnInitialized() => Preferences.Changed += OnPreferencesChanged;

  private void OnPreferencesChanged() => InvokeAsync(StateHasChanged);

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    try
    {
      _systemDark = await SystemTheme.PrefersDarkAsync();
      _subscription = await SystemTheme.ListenAsync(dark => InvokeAsync(() =>
      {
        _systemDark = dark;
        StateHasChanged();
      }));
      StateHasChanged();
    }
    catch (JSException)
    {
      // The system preference can't be read: the toggle treats the system as light. The CSS media query
      // still themes the page correctly while following the system.
    }
  }

  public async ValueTask DisposeAsync()
  {
    Preferences.Changed -= OnPreferencesChanged;
    if (_subscription is not null)
    {
      await _subscription.DisposeAsync();
    }
  }

  private void Flip() =>
    Preferences.Save(Preferences.Current with { Theme = IsDark ? ThemeChoice.Light : ThemeChoice.Dark });

}
