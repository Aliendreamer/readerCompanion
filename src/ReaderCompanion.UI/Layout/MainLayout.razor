@inherits LayoutComponentBase
@implements IDisposable
@using ReaderCompanion.Core.Preferences
@inject IAppPreferences Preferences

<div class="app" data-theme="@Preferences.Current.Theme.ToString().ToLowerInvariant()">
  <Sidebar />
  <main>
    @Body
  </main>
</div>

@code {
  protected override void OnInitialized() => Preferences.Changed += OnChanged;

  private void OnChanged() => InvokeAsync(StateHasChanged);

  public void Dispose() => Preferences.Changed -= OnChanged;
}
