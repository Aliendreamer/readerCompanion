@inherits LayoutComponentBase
@implements IDisposable
@using ReaderCompanion.Core.Preferences
@inject IAppPreferences Preferences
@inject IAppWindow Window

<div class="app @(WindowFrame.Shown(Window) ? "has-frame" : "")" data-theme="@Preferences.Current.Theme.ToString().ToLowerInvariant()">
  <WindowFrame />
  <Toolbar />
  <main>
    @Body
  </main>
  <StatusBar />
</div>

@code {
  protected override void OnInitialized()
  {
    Preferences.Changed += OnChanged;
    Window.Changed += OnChanged;
  }

  private void OnChanged() => InvokeAsync(StateHasChanged);

  public void Dispose()
  {
    Preferences.Changed -= OnChanged;
    Window.Changed -= OnChanged;
  }
}
