<Project Sdk="Microsoft.NET.Sdk">

  <!-- Holds the app's Google OAuth client. The build reads google-oauth-client.json from the repository root (stored
       encrypted with git-crypt), scrambles the ID and secret with a key made fresh for each build, and compiles them
       in as generated source (obj/ClientData.g.cs). The JSON itself is never copied to any output. Without the file,
       or in Claude Code's sandbox (CLAUDECODE=1, which may not read it), the generated data is empty and the app has
       no built-in client. -->

  <ItemGroup>
    <InternalsVisibleTo Include="ReaderCompanion.Data.Tests" />
  </ItemGroup>

  <!-- Release: no symbols file, which would list the original names the obfuscator removes. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <ClientFile>$(MSBuildThisFileDirectory)..\..\google-oauth-client.json</ClientFile>
    <UseClientFile Condition="Exists('$(ClientFile)') And '$(CLAUDECODE)' != '1'">true</UseClientFile>
  </PropertyGroup>

  <UsingTask TaskName="WriteClientData" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ClientFile ParameterType="System.String" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string id = null, secret = null;
        if (!string.IsNullOrEmpty(ClientFile))
        {
          var json = File.ReadAllText(ClientFile);
          id = Regex.Match(json, "\"client_id\"\\s*:\\s*\"([^\"]+)\"").Groups[1].Value;
          secret = Regex.Match(json, "\"client_secret\"\\s*:\\s*\"([^\"]+)\"").Groups[1].Value;
          if (id.Length == 0 || secret.Length == 0) { id = secret = null; } // a locked (git-crypt) or unusable file
        }

        // Must match Scrambler.Mix.
        Func<string, byte[], string> scramble = (text, key) =>
        {
          var bytes = Encoding.UTF8.GetBytes(text);
          var mixed = bytes.Select((b, i) => (byte)(b ^ key[i % key.Length] ^ (byte)(i * 31)));
          return "[" + string.Join(", ", mixed.Select(b => "0x" + b.ToString("x2"))) + "]";
        };

        var code = new StringBuilder();
        code.AppendLine("// <auto-generated>Made by the build from google-oauth-client.json; do not commit.</auto-generated>");
        code.AppendLine("#nullable enable");
        code.AppendLine("namespace ReaderCompanion.Client;");
        code.AppendLine("internal static class ClientData");
        code.AppendLine("{");
        if (id != null)
        {
          var key = new byte[32]; // fresh per build: no two builds share it
          using (var random = RandomNumberGenerator.Create()) { random.GetBytes(key); }
          code.AppendLine("    public static readonly byte[]? Key = [" + string.Join(", ", key.Select(b => "0x" + b.ToString("x2"))) + "];");
          code.AppendLine("    public static readonly byte[]? Id = " + scramble(id, key) + ";");
          code.AppendLine("    public static readonly byte[]? Secret = " + scramble(secret, key) + ";");
        }
        else
        {
          code.AppendLine("    public static readonly byte[]? Key = null;");
          code.AppendLine("    public static readonly byte[]? Id = null;");
          code.AppendLine("    public static readonly byte[]? Secret = null;");
        }

        code.AppendLine("}");
        var text = code.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text || id != null)
        {
          Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
          File.WriteAllText(OutputFile, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The obj folder is only known once the SDK's targets are in, so the path is set in a target. -->
  <Target Name="ClientDataPath" BeforeTargets="GenerateClientData;GenerateEmptyClientData">
    <PropertyGroup>
      <ClientDataFile>$(ProjectDir)$(IntermediateOutputPath)ClientData.g.cs</ClientDataFile>
    </PropertyGroup>
  </Target>

  <!-- Runs when the client file changed (or the generated file is missing). -->
  <Target Name="GenerateClientData" BeforeTargets="CoreCompile" DependsOnTargets="ClientDataPath"
          Inputs="$(MSBuildProjectFullPath);$(ClientFile)" Outputs="$(ClientDataFile)"
          Condition="'$(UseClientFile)' == 'true'">
    <WriteClientData ClientFile="$(ClientFile)" OutputFile="$(ClientDataFile)" />
  </Target>
  <Target Name="GenerateEmptyClientData" BeforeTargets="CoreCompile" DependsOnTargets="ClientDataPath" Condition="'$(UseClientFile)' != 'true'">
    <WriteClientData OutputFile="$(ClientDataFile)" />
  </Target>
  <Target Name="IncludeClientData" BeforeTargets="CoreCompile" AfterTargets="GenerateClientData;GenerateEmptyClientData">
    <ItemGroup>
      <Compile Include="$(ClientDataFile)" />
    </ItemGroup>
  </Target>

  <!-- Release: Obfuscar (local tool, pinned in dotnet-tools.json) renames everything but the public API and hides
       strings in the compiled assembly, before it is copied to bin or publish. Only this assembly: EF Core and Blazor
       use reflection that renaming would break. Runs again only when the assembly was rebuilt. -->
  <Target Name="Obfuscate" AfterTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'"
          Inputs="@(IntermediateAssembly)" Outputs="$(ProjectDir)$(IntermediateOutputPath)obfuscated.stamp">
    <PropertyGroup>
      <ObfuscateIn>$(ProjectDir)$(IntermediateOutputPath)obfuscate-in</ObfuscateIn>
      <ObfuscateOut>$(ProjectDir)$(IntermediateOutputPath)obfuscate-out</ObfuscateOut>
      <ObfuscateConfig>$(ProjectDir)$(IntermediateOutputPath)obfuscar.xml</ObfuscateConfig>
    </PropertyGroup>
    <RemoveDir Directories="$(ObfuscateIn);$(ObfuscateOut)" />
    <Copy SourceFiles="@(IntermediateAssembly)" DestinationFolder="$(ObfuscateIn)" />
    <WriteLinesToFile File="$(ObfuscateConfig)" Overwrite="true" Lines="
&lt;Obfuscator&gt;
  &lt;Var name=&quot;InPath&quot; value=&quot;$(ObfuscateIn)&quot; /&gt;
  &lt;Var name=&quot;OutPath&quot; value=&quot;$(ObfuscateOut)&quot; /&gt;
  &lt;Var name=&quot;KeepPublicApi&quot; value=&quot;true&quot; /&gt;
  &lt;Var name=&quot;HidePrivateApi&quot; value=&quot;true&quot; /&gt;
  &lt;Var name=&quot;HideStrings&quot; value=&quot;true&quot; /&gt;
  &lt;Var name=&quot;RenameFields&quot; value=&quot;true&quot; /&gt;
  &lt;Var name=&quot;RenameProperties&quot; value=&quot;true&quot; /&gt;
  &lt;Var name=&quot;UseUnicodeNames&quot; value=&quot;true&quot; /&gt;
  &lt;Module file=&quot;$(ObfuscateIn)/$(TargetFileName)&quot; /&gt;
&lt;/Obfuscator&gt;" />
    <Exec Command="dotnet tool run obfuscar.console &quot;$(ObfuscateConfig)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." StandardOutputImportance="low" />
    <Copy SourceFiles="$(ObfuscateOut)/$(TargetFileName)" DestinationFiles="@(IntermediateAssembly)" />
    <Touch Files="$(ProjectDir)$(IntermediateOutputPath)obfuscated.stamp" AlwaysCreate="true" />
  </Target>

</Project>
