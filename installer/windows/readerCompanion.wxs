<!-- The Windows installer (WiX 5). Installs for the current user, without an administrator prompt: a per-user package
     puts ProgramFiles64Folder under %LocalAppData%\Programs. Built by scripts/installer-msi.sh with -d Version=x.y.z,
     -d IconFile=<the .ico, full path> and -bindpath App=<the win-x64 package folder, full path>. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode never changes: it is how a newer version finds and replaces an older one. -->
  <Package Name="readerCompanion" Manufacturer="Aliendreamer" Version="$(Version)" Scope="perUser"
           UpgradeCode="AF06889B-C801-4838-8827-DAB26C3C55A6">
    <MajorUpgrade DowngradeErrorMessage="A newer version of readerCompanion is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Aliendreamer/readerCompanion" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="readerCompanion">
        <!-- The package, without symbol files (.pdb), which are for debugging. -->
        <Files Include="!(bindpath.App)\**">
          <Exclude Files="!(bindpath.App)\**\*.pdb" />
        </Files>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenu" Name="readerCompanion" Description="E-book library and reading tracker"
                  Target="[INSTALLFOLDER]ReaderCompanion.Desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <!-- A per-user shortcut needs a registry value as its key path. -->
        <RegistryValue Root="HKCU" Key="Software\readerCompanion" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
