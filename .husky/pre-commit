# Files marked filter=git-crypt in .gitattributes must be staged encrypted: without `git-crypt init`/`unlock`
# git would store them in plain text.
git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
  if [ "$(git check-attr filter -- "$file" | sed 's/^.*: filter: //')" = git-crypt ] \
    && ! git cat-file blob ":$file" | head -c 10 | tr -d '\0' | grep -q '^GITCRYPT'; then
    echo "pre-commit: $file would be committed unencrypted. Run 'git-crypt init' (or 'git-crypt unlock') first." >&2
    exit 1
  fi
done || exit 1

pnpm exec lint-staged
